# Local development only. Do not reuse these credentials in production.
COMPOSE_PROJECT_NAME=kilatmart

POSTGRES_DB=kilatmart
POSTGRES_USER=kilatmart
POSTGRES_PASSWORD=kilatmart_dev_only
# Host port only; containers still reach PostgreSQL at postgres:5432.
# 15432 avoids clashing with a locally installed PostgreSQL on 5432.
POSTGRES_PORT=15432

# RabbitMQ credentials are defined in rabbitmq/definitions.json, not here.
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
